# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store/

# Local Cursor / agent tooling (skills binaries are large; not app source)
.cursor/
.agents/

# Hardlink mirror tree (canonical files live under public/assets/*)
public/assets/_organized/

# Original camera .mov (~117MB) exceeds GitHub's 100MB limit.
# Site uses the compressed .mp4 instead; keep the .mov local-only.
*.mov
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
